  "param_columns": {
    "note": "③ 效果段 的参数列按 param_labels 展开成中文列，按行为/形状分组折叠；每行只亮必填格。",
    "color_rule": "yellow=本行必填（只按 behavior_required）；gray=不用填（工具也不读）；white=选填；red=校验失败。形状尺寸参数列属选填/建议，不因 shape_keys 标黄。",
    "unknown_param_policy": "任何现有内容里出现但 param_labels 未覆盖的参数键，原样写入该行 __extras，生成时原样还原，保证零丢失",
    "shape_keys_policy": "shape_keys 是『判定 cfg 按形状可取的参数键』，不是内容必填键。校验：填了的值必须在合法键范围内；该形状全部尺寸参数列均为空时只给黄色提醒、不拦截。依据：shape_hit.gd 第 17 行（line 的 length 缺省回退 range 承载）与台账 D-46（引导圆用 range 承载半径），现有引导类内容正是用『扇形距离』承载圆/线尺寸。",
    "example_row_policy_marker": "【示例】"
  },
  "extras_policy": {
    "note": "__extras 存该行所有未被显式中文列覆盖的字段（含数组/字典/复杂结构）的 JSON 原文。",
    "generate_rule": "W3 生成时：先按显式列填值，再用 __extras 补齐缺失字段；显式列非空时以显式列为准。",
    "why": "保证 80 条现有内容一个字段都不丢，同时策划只面对简单中文列。"
  },
  "id_rule": {
    "existing": "反向导出时把现有 gem_id / support_id 原样带入只读列；改中文名不改代号。",
    "new": "新增行由工具自动生成 skill_ / support_ + 三位序号，生成后锁定不变。",
    "check": "代号必须唯一、且必须与目标资源文件名一致；冲突即中文报错。"
  },
  "numeric_range": {
    "source": "运行时由工具从 80 条现有内容统计得出，不在契约里硬编码。",
    "action": "超出统计区间只给黄色提醒，不硬性拦截。"
  },
  "trigger_policy": {
    "note": "唯一的演示触发器不参与表格化，工具不生成、不修改、不删除，W5 验证其字节不变。"
  },
