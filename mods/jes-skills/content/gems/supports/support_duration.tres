[gd_resource type="Resource" script_class="SupportGemData" format=3]

; 夜间施工批次 D（D-45）：持续延长——时长型辅助补缺。
; D-42 契约：duration 由 aoe（延迟/多段）/ channel（引导时长）/ summon（存续）/ buff（增益时长）
; 四类行为消费，故用「任一满足」锁定这四个形态，杜绝装上静默无效。
; 数值定稿（D-55，2026-10-22 制作人裁定按推算值转正，后续大 playtest 统一回调）：+30% 持续时间，与范围扩大（+30%）同档位。

[ext_resource type="Script" path="res://mods/jes-skills/systems/skills/data/support_gem_data.gd" id="1_dur"]
[ext_resource type="Script" path="res://mods/jes-skills/systems/skills/data/modifier_spec.gd" id="2_dur"]

[sub_resource type="Resource" id="Resource_dur_mod"]
script = ExtResource("2_dur")
stat = &"duration"
op = 1
value = 30.0

[resource]
script = ExtResource("1_dur")
support_id = &"support_duration"
display_name = "持续延长"
require_any_tags = Array[StringName]([&"aoe", &"channel", &"summon", &"buff"])
cost_multiplier = 1.25
stat_modifiers = Array[ExtResource("2_dur")]([SubResource("Resource_dur_mod")])
