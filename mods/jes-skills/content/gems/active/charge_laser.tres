[gd_resource type="Resource" script_class="SkillData" format=3]

; 格号 CHAN·LINE·DLY（展开表 v2 §1.3）· 夜间施工批次 C
; 蓄力激光：蓄力后直线贯穿（双段表达：引导蓄力段不产出伤害 + 延迟线爆段，D-45）

[ext_resource type="Script" path="res://mods/jes-skills/systems/skills/data/gem_level_scaling.gd" id="1_cls"]
[ext_resource type="Script" path="res://mods/jes-skills/systems/skills/data/skill_part.gd" id="2_cls"]
[ext_resource type="Script" path="res://mods/jes-skills/systems/skills/data/skill_data.gd" id="3_cls"]

[sub_resource type="Resource" id="Resource_cls_scale"]
script = ExtResource("1_cls")
per_level = 0.1

[sub_resource type="Resource" id="Resource_cls_p1"]
script = ExtResource("2_cls")
behavior_id = &"bhv_channel"
behavior_params = {
&"shape": &"line",
&"range": 240.0,
&"tick_interval": 0.3,
&"max_channel_time": 1.2
}

[sub_resource type="Resource" id="Resource_cls_p2"]
script = ExtResource("2_cls")
base_damage = {
&"chaos": 175.0
}
behavior_id = &"bhv_aoe_burst"
behavior_params = {
&"shape": &"line",
&"length": 240.0,
&"width": 44.0,
&"delay": 0.2,
&"hit_count": 1,
&"hit_interval": 0.0
}

[resource]
script = ExtResource("3_cls")
gem_id = &"charge_laser"
display_name = "蓄力激光"
parts = Array[ExtResource("2_cls")]([SubResource("Resource_cls_p1"), SubResource("Resource_cls_p2")])
tags = Array[StringName]([&"spell", &"channel", &"aoe", &"chaos"])
cast_mode = 0
base_cast_time = 0.5
cost_type = 0
base_cost = 15.0
base_cooldown = 4.4
max_charges = 0
charge_recharge_time = 0.0
level_scaling = SubResource("Resource_cls_scale")
