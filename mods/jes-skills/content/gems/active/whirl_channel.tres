[gd_resource type="Resource" script_class="SkillData" format=3]

; 格号 CHAN·CIRC·TICK（展开表 v2 §1.3）· 夜间施工批次 C
; 原地旋风：自身周围反复范围判定（引导×圆；圆半径由 range 承载，D-45 承载口径）

[ext_resource type="Script" path="res://mods/jes-skills/systems/skills/data/gem_level_scaling.gd" id="1_whc"]
[ext_resource type="Script" path="res://mods/jes-skills/systems/skills/data/skill_part.gd" id="2_whc"]
[ext_resource type="Script" path="res://mods/jes-skills/systems/skills/data/skill_data.gd" id="3_whc"]

[sub_resource type="Resource" id="Resource_whc_scale"]
script = ExtResource("1_whc")
per_level = 0.1

[sub_resource type="Resource" id="Resource_whc_part"]
script = ExtResource("2_whc")
base_damage = {
&"physical": 12.0
}
behavior_id = &"bhv_channel"
behavior_params = {
&"shape": &"circ",
&"range": 110.0,
&"tick_interval": 0.3,
&"max_channel_time": 2.4
}

[resource]
script = ExtResource("3_whc")
gem_id = &"whirl_channel"
display_name = "原地旋风"
parts = Array[ExtResource("2_whc")]([SubResource("Resource_whc_part")])
