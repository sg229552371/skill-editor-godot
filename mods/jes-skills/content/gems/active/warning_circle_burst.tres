&"shape": &"circ",
&"radius": 150.0,
&"delay": 0.9,
&"hit_count": 1,
&"hit_interval": 0.0
}

[resource]
script = ExtResource("3_wcb")
gem_id = &"warning_circle_burst"
display_name = "预警爆圈"
