&"shape": &"multi",
&"point_count": 6,
&"point_spacing": 80.0,
&"radius": 60.0,
&"delay": 0.0,
&"hit_count": 1,
&"hit_interval": 0.0
}

[resource]
script = ExtResource("3_mbs")
gem_id = &"multi_burst"
display_name = "周身多点爆"
parts = Array[ExtResource("2_mbs")]([SubResource("Resource_mbs_part")])
tags = Array[StringName]([&"spell", &"aoe", &"fire"])
cast_mode = 0
base_cast_time = 0.45
cost_type = 0
base_cost = 11.0
