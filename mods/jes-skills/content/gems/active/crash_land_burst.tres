[gd_resource type="Resource" script_class="SkillData" format=3]

; 格号 DASH·CIRC·DLY（展开表 v2 §1.4）· 夜间施工批次 C
; 冲撞落点爆：冲过去后原地延迟爆（双段：位移段不产出路径伤害 + 延迟圆爆段）

[ext_resource type="Script" path="res://mods/jes-skills/systems/skills/data/gem_level_scaling.gd" id="1_clb"]
[ext_resource type="Script" path="res://mods/jes-skills/systems/skills/data/skill_part.gd" id="2_clb"]
[ext_resource type="Script" path="res://mods/jes-skills/systems/skills/data/skill_data.gd" id="3_clb"]

[sub_resource type="Resource" id="Resource_clb_scale"]
script = ExtResource("1_clb")
per_level = 0.1

[sub_resource type="Resource" id="Resource_clb_p1"]
script = ExtResource("2_clb")
behavior_id = &"bhv_dash"
behavior_params = {
&"distance": 380.0,
&"speed": 1100.0,
&"path_width": 50.0
}

[sub_resource type="Resource" id="Resource_clb_p2"]
script = ExtResource("2_clb")
base_damage = {
&"fire": 125.0
}
behavior_id = &"bhv_aoe_burst"
behavior_params = {
&"shape": &"circ",
&"radius": 130.0,
&"delay": 0.5,
&"hit_count": 1,
&"hit_interval": 0.0
}

[resource]
script = ExtResource("3_clb")
gem_id = &"crash_land_burst"
display_name = "冲撞落点爆"
parts = Array[ExtResource("2_clb")]([SubResource("Resource_clb_p1"), SubResource("Resource_clb_p2")])
tags = Array[StringName]([&"attack", &"movement", &"aoe", &"fire"])
cast_mode = 0
base_cast_time = 0.2
cost_type = 0
base_cost = 13.0
base_cooldown = 4.2
max_charges = 0
charge_recharge_time = 0.0
level_scaling = SubResource("Resource_clb_scale")
