[gd_resource type="Resource" script_class="SkillData" format=3]

; 格号 CHAN·PT·DLY（展开表 v2 §1.3）· 夜间施工批次 C
; 蓄力单爆：引导蓄力、松手单体爆（双段表达：引导蓄力段不产出伤害 + 延迟点爆段，D-45）

[ext_resource type="Script" path="res://mods/jes-skills/systems/skills/data/gem_level_scaling.gd" id="1_csn"]
[ext_resource type="Script" path="res://mods/jes-skills/systems/skills/data/skill_part.gd" id="2_csn"]
[ext_resource type="Script" path="res://mods/jes-skills/systems/skills/data/skill_data.gd" id="3_csn"]

[sub_resource type="Resource" id="Resource_csn_scale"]
script = ExtResource("1_csn")
per_level = 0.1

[sub_resource type="Resource" id="Resource_csn_p1"]
script = ExtResource("2_csn")
behavior_id = &"bhv_channel"
behavior_params = {
&"shape": &"pt",
&"tick_interval": 0.25,
&"max_channel_time": 1.0
}

[sub_resource type="Resource" id="Resource_csn_p2"]
script = ExtResource("2_csn")
base_damage = {
&"lightning": 165.0
}
behavior_id = &"bhv_aoe_burst"
behavior_params = {
&"shape": &"pt",
&"delay": 0.25,
&"hit_count": 1,
&"hit_interval": 0.0
}

[resource]
script = ExtResource("3_csn")
gem_id = &"charge_snap"
display_name = "蓄力单爆"
parts = Array[ExtResource("2_csn")]([SubResource("Resource_csn_p1"), SubResource("Resource_csn_p2")])
tags = Array[StringName]([&"spell", &"channel", &"aoe", &"lightning"])
cast_mode = 0
base_cast_time = 0.5
cost_type = 0
base_cost = 14.0
base_cooldown = 4.0
max_charges = 0
charge_recharge_time = 0.0
level_scaling = SubResource("Resource_csn_scale")
