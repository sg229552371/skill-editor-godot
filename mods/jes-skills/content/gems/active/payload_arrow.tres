[gd_resource type="Resource" script_class="SkillData" format=3]

; 格号 FLY·PT·DLY（展开表 v2 §1.1）· 夜间施工批次 C
; 载荷箭：弹体飞行，命中点延迟爆开（双段：投射段 + 延迟圆爆段）

[ext_resource type="Script" path="res://mods/jes-skills/systems/skills/data/gem_level_scaling.gd" id="1_pla"]
[ext_resource type="Script" path="res://mods/jes-skills/systems/skills/data/skill_part.gd" id="2_pla"]
[ext_resource type="Script" path="res://mods/jes-skills/systems/skills/data/skill_data.gd" id="3_pla"]

[sub_resource type="Resource" id="Resource_pla_scale"]
script = ExtResource("1_pla")
per_level = 0.1

[sub_resource type="Resource" id="Resource_pla_p1"]
script = ExtResource("2_pla")
base_damage = {
&"physical": 30.0
}
behavior_id = &"bhv_projectile"
behavior_params = {
&"count_base": 1.0,
&"lifetime": 1.2,
&"radius": 12.0,
&"speed": 650.0,
&"spread_deg": 4.0
}

[sub_resource type="Resource" id="Resource_pla_p2"]
script = ExtResource("2_pla")
base_damage = {
&"fire": 90.0
}
behavior_id = &"bhv_aoe_burst"
behavior_params = {
&"shape": &"circ",
&"radius": 90.0,
&"delay": 0.35,
&"hit_count": 1,
&"hit_interval": 0.0
}

[resource]
script = ExtResource("3_pla")
gem_id = &"payload_arrow"
display_name = "载荷箭"
parts = Array[ExtResource("2_pla")]([SubResource("Resource_pla_p1"), SubResource("Resource_pla_p2")])
tags = Array[StringName]([&"attack", &"projectile", &"aoe", &"fire"])
cast_mode = 0
base_cast_time = 0.4
cost_type = 0
base_cost = 12.0
base_cooldown = 3.5
max_charges = 0
charge_recharge_time = 0.0
level_scaling = SubResource("Resource_pla_scale")
