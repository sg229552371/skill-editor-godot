; 星落弹幕：多发散射弹延迟落地（多点键未写，按展开表「多点键可选」用散射参数表达）

[ext_resource type="Script" path="res://mods/jes-skills/systems/skills/data/gem_level_scaling.gd" id="1_sfb"]
[ext_resource type="Script" path="res://mods/jes-skills/systems/skills/data/skill_part.gd" id="2_sfb"]
[ext_resource type="Script" path="res://mods/jes-skills/systems/skills/data/skill_data.gd" id="3_sfb"]

[sub_resource type="Resource" id="Resource_sfb_scale"]
script = ExtResource("1_sfb")
