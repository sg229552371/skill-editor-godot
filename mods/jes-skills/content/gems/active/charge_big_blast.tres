[gd_resource type="Resource" script_class="SkillData" format=3]

; 格号 CHAN·CIRC·DLY（展开表 v2 §1.3）· 夜间施工批次 C
; 蓄力大爆：引导越久爆得越大（双段表达：引导蓄力段不产出伤害 + 延迟大圆爆段，D-45）

[ext_resource type="Script" path="res://mods/jes-skills/systems/skills/data/gem_level_scaling.gd" id="1_cbg"]
[ext_resource type="Script" path="res://mods/jes-skills/systems/skills/data/skill_part.gd" id="2_cbg"]
[ext_resource type="Script" path="res://mods/jes-skills/systems/skills/data/skill_data.gd" id="3_cbg"]

[sub_resource type="Resource" id="Resource_cbg_scale"]
script = ExtResource("1_cbg")
per_level = 0.1

[sub_resource type="Resource" id="Resource_cbg_p1"]
script = ExtResource("2_cbg")
behavior_id = &"bhv_channel"
behavior_params = {
&"shape": &"circ",
&"range": 120.0,
&"tick_interval": 0.3,
&"max_channel_time": 1.2
}

[sub_resource type="Resource" id="Resource_cbg_p2"]
script = ExtResource("2_cbg")
base_damage = {
&"fire": 180.0
}
behavior_id = &"bhv_aoe_burst"
behavior_params = {
&"shape": &"circ",
&"radius": 160.0,
&"delay": 0.3,
&"hit_count": 1,
&"hit_interval": 0.0
}

[resource]
script = ExtResource("3_cbg")
gem_id = &"charge_big_blast"
display_name = "蓄力大爆"
parts = Array[ExtResource("2_cbg")]([SubResource("Resource_cbg_p1"), SubResource("Resource_cbg_p2")])
tags = Array[StringName]([&"spell", &"channel", &"aoe", &"fire"])
cast_mode = 0
base_cast_time = 0.5
cost_type = 0
base_cost = 15.0
base_cooldown = 4.5
max_charges = 0
charge_recharge_time = 0.0
level_scaling = SubResource("Resource_cbg_scale")
