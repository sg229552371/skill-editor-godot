[gd_resource type="Resource" script_class="SkillData" format=3]

; 格号 CHAN·LINE·ZONE（展开表 v2 §1.3）· 夜间施工批次 C
; 持续光束：引导期间直线常驻（长引导 + 密 tick）

[ext_resource type="Script" path="res://mods/jes-skills/systems/skills/data/gem_level_scaling.gd" id="1_sbd"]
[ext_resource type="Script" path="res://mods/jes-skills/systems/skills/data/skill_part.gd" id="2_sbd"]
[ext_resource type="Script" path="res://mods/jes-skills/systems/skills/data/skill_data.gd" id="3_sbd"]

[sub_resource type="Resource" id="Resource_sbd_scale"]
script = ExtResource("1_sbd")
per_level = 0.1

[sub_resource type="Resource" id="Resource_sbd_part"]
script = ExtResource("2_sbd")
base_damage = {
&"lightning": 10.0
}
behavior_id = &"bhv_channel"
behavior_params = {
&"shape": &"line",
&"range": 230.0,
&"tick_interval": 0.25,
&"max_channel_time": 3.0
}

[resource]
script = ExtResource("3_sbd")
gem_id = &"sustained_beam"
display_name = "持续光束"
parts = Array[ExtResource("2_sbd")]([SubResource("Resource_sbd_part")])
tags = Array[StringName]([&"spell", &"channel", &"lightning"])
cast_mode = 0
base_cast_time = 0.4
cost_type = 0
base_cost = 13.0
base_cooldown = 3.75
max_charges = 0
charge_recharge_time = 0.0
level_scaling = SubResource("Resource_sbd_scale")
