[ext_resource type="Script" path="res://mods/jes-skills/systems/skills/data/gem_level_scaling.gd" id="1_vcb"]
[ext_resource type="Script" path="res://mods/jes-skills/systems/skills/data/skill_part.gd" id="2_vcb"]
[ext_resource type="Script" path="res://mods/jes-skills/systems/skills/data/skill_data.gd" id="3_vcb"]

[sub_resource type="Resource" id="Resource_vcb_scale"]
