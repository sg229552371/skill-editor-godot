[gd_resource type="Resource" script_class="SkillData" format=3]

; 格号 DASH·RING·DLY（展开表 v2 §1.4）· 夜间施工批次 C
; 延迟终点环爆：终点预警后爆出空环（双段：位移段 + 延迟空环段）

[ext_resource type="Script" path="res://mods/jes-skills/systems/skills/data/gem_level_scaling.gd" id="1_der"]
[ext_resource type="Script" path="res://mods/jes-skills/systems/skills/data/skill_part.gd" id="2_der"]
[ext_resource type="Script" path="res://mods/jes-skills/systems/skills/data/skill_data.gd" id="3_der"]

[sub_resource type="Resource" id="Resource_der_scale"]
script = ExtResource("1_der")
per_level = 0.1

[sub_resource type="Resource" id="Resource_der_p1"]
script = ExtResource("2_der")
behavior_id = &"bhv_dash"
behavior_params = {
&"distance": 360.0,
&"speed": 1100.0,
&"path_width": 40.0
}

[sub_resource type="Resource" id="Resource_der_p2"]
script = ExtResource("2_der")
base_damage = {
&"fire": 125.0
}
behavior_id = &"bhv_aoe_burst"
behavior_params = {
&"shape": &"ring",
&"radius": 140.0,
&"inner_radius": 80.0,
&"delay": 0.7,
&"hit_count": 1,
&"hit_interval": 0.0
}

[resource]
script = ExtResource("3_der")
gem_id = &"delayed_end_ring"
display_name = "延迟终点环爆"
parts = Array[ExtResource("2_der")]([SubResource("Resource_der_p1"), SubResource("Resource_der_p2")])
tags = Array[StringName]([&"attack", &"movement", &"aoe", &"fire"])
cast_mode = 0
base_cast_time = 0.2
cost_type = 0
base_cost = 14.0
base_cooldown = 4.4
max_charges = 0
charge_recharge_time = 0.0
level_scaling = SubResource("Resource_der_scale")
