; 多重毒圈弹：多发散射弹各留持续毒圈（zone_duration 未实现，多段模拟，D-45）

[ext_resource type="Script" path="res://mods/jes-skills/systems/skills/data/gem_level_scaling.gd" id="1_mvb"]
[ext_resource type="Script" path="res://mods/jes-skills/systems/skills/data/skill_part.gd" id="2_mvb"]
[ext_resource type="Script" path="res://mods/jes-skills/systems/skills/data/skill_data.gd" id="3_mvb"]

[sub_resource type="Resource" id="Resource_mvb_scale"]
