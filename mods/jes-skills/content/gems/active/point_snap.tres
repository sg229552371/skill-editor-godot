[ext_resource type="Script" path="res://mods/jes-skills/systems/skills/data/skill_part.gd" id="2_psn"]
[ext_resource type="Script" path="res://mods/jes-skills/systems/skills/data/skill_data.gd" id="3_psn"]

[sub_resource type="Resource" id="Resource_psn_scale"]
