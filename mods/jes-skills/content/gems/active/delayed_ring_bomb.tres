[gd_resource type="Resource" script_class="SkillData" format=3]

; 格号 FLY·RING·DLY（展开表 v2 §1.1）· 夜间施工批次 C
; 延时环爆弹：落点预警后爆出空环（延迟越长风险回报越高，手册 C2）

[ext_resource type="Script" path="res://mods/jes-skills/systems/skills/data/gem_level_scaling.gd" id="1_drb"]
[ext_resource type="Script" path="res://mods/jes-skills/systems/skills/data/skill_part.gd" id="2_drb"]
[ext_resource type="Script" path="res://mods/jes-skills/systems/skills/data/skill_data.gd" id="3_drb"]

[sub_resource type="Resource" id="Resource_drb_scale"]
script = ExtResource("1_drb")
per_level = 0.1

[sub_resource type="Resource" id="Resource_drb_p1"]
script = ExtResource("2_drb")
base_damage = {
&"fire": 25.0
}
behavior_id = &"bhv_projectile"
behavior_params = {
&"count_base": 1.0,
&"lifetime": 1.6,
&"radius": 12.0,
&"speed": 600.0,
&"spread_deg": 4.0
}

[sub_resource type="Resource" id="Resource_drb_p2"]
script = ExtResource("2_drb")
base_damage = {
&"fire": 100.0
}
behavior_id = &"bhv_aoe_burst"
behavior_params = {
&"shape": &"ring",
&"radius": 150.0,
&"inner_radius": 85.0,
&"delay": 0.8,
&"hit_count": 1,
&"hit_interval": 0.0
}

[resource]
script = ExtResource("3_drb")
gem_id = &"delayed_ring_bomb"
display_name = "延时环爆弹"
parts = Array[ExtResource("2_drb")]([SubResource("Resource_drb_p1"), SubResource("Resource_drb_p2")])
tags = Array[StringName]([&"spell", &"projectile", &"aoe", &"fire"])
cast_mode = 0
base_cast_time = 0.4
cost_type = 0
base_cost = 15.0
base_cooldown = 4.5
max_charges = 0
charge_recharge_time = 0.0
level_scaling = SubResource("Resource_drb_scale")
