# OS
Thumbs.db
.DS_Store

# Local agent memory / workspace data
# 注意：.workbuddy/skills/ 是**要入库的**（项目级 skill，换设备要跟着走），
# 所以不能整个 .workbuddy/ 一刀切；memory/ 与 tmp/ 仍留在本机不入库。
.workbuddy/*
!.workbuddy/skills/

# 本机 Godot 版本固定（GodotHub 生成，机器相关）
.godotrc

# 构建/发布产物与本地缓存（不入库）
dist/
*.genie

# 策划配置表工具的中间产物（干跑资源 / 中间 JSON，不入库）
mods/jes-skills/tools/content_workbench/_tmp/
mods/jes-skills/tools/content_workbench/**/_tmp/
mods/jes-skills/tools/content_workbench/**/__pycache__/
__pycache__/
*.pyc
# 项目根的一次性脚手架产物（子代理自检残留，不入库）
/_tmp/
/_tmp_probe.py

# 本机 Godot 编辑器数据 / 环境残留（不入库）
/Godot/
/undefined/
